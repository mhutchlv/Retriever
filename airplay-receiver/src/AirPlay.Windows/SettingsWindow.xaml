<Window x:Class="AirPlay.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Receiver name" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password (optional)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Aspect ratio" VerticalAlignment="Center" Margin="0,4" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AspectBox" Margin="0,4">
            <ComboBoxItem Content="Fit (letterbox)" />
            <ComboBoxItem Content="Fill (crop)" />
            <ComboBoxItem Content="Stretch" />
        </ComboBox>

        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="AlwaysOnTopBox" Content="Always on top" Margin="0,6,0,2" />
        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="StartWithWindowsBox" Content="Start with Windows (minimized)" Margin="0,2" />
        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="MinimizeToTrayBox" Content="Minimize to the system tray" Margin="0,2" />
        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="StartMinimizedBox" Content="Start minimized" Margin="0,2" />
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="EnableAudioBox" Content="Play mirrored audio (needs libfdk-aac-2.dll)" Margin="0,2" />
        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="HevcBox" Content="Advertise HEVC (experimental, needs HEVC Video Extensions)" Margin="0,2" />
        <CheckBox Grid.Row="9" Grid.Column="1" x:Name="TakeoverBox" Content="Let a new device replace the current one" Margin="0,2" />
        <CheckBox Grid.Row="10" Grid.Column="1" x:Name="VerboseBox" Content="Verbose log (receiver.log)" Margin="0,2,0,8" />

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Windows Firewall" VerticalAlignment="Center" Margin="0,4" />
        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <Button x:Name="FirewallButton" Content="Add firewall rule..." Padding="10,3" Click="OnFirewallClick" />
            <TextBlock x:Name="FirewallStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
        </StackPanel>

        <TextBlock Grid.Row="12" Grid.Column="1" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Name, password, HEVC and port changes restart the receiver. Ports: RTSP 7000, video 7100, audio 6000/6001, timing 7011 (edit settings.json to change)." />

        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="80" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
