<Window x:Class="AirPlay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPlay Receiver" Width="540" Height="960" MinWidth="240" MinHeight="200"
        Background="Black" KeyDown="OnKeyDown" MouseDoubleClick="OnMouseDoubleClick"
        Closing="OnClosing" StateChanged="OnStateChanged">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Fullscreen" InputGestureText="F11" Click="OnToggleFullscreen" />
            <MenuItem x:Name="AlwaysOnTopItem" Header="Always on top" IsCheckable="True" InputGestureText="Ctrl+T" Click="OnToggleAlwaysOnTop" />
            <MenuItem Header="Aspect ratio">
                <MenuItem x:Name="AspectFitItem" Header="Fit (letterbox)" IsCheckable="True" Click="OnAspectFit" />
                <MenuItem x:Name="AspectFillItem" Header="Fill (crop)" IsCheckable="True" Click="OnAspectFill" />
                <MenuItem x:Name="AspectStretchItem" Header="Stretch" IsCheckable="True" Click="OnAspectStretch" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Save screenshot" InputGestureText="Ctrl+S" Click="OnScreenshot" />
            <MenuItem x:Name="RecordItem" Header="Record stream to .h264" IsCheckable="True" InputGestureText="Ctrl+R" Click="OnToggleRecording" />
            <MenuItem Header="Disconnect device" Click="OnDisconnect" />
            <Separator />
            <MenuItem Header="Settings..." InputGestureText="Ctrl+," Click="OnSettings" />
            <MenuItem Header="Open log folder" Click="OnOpenLogFolder" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExit" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" SnapsToDevicePixels="True" />

        <Border x:Name="Overlay" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="24,20"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <StackPanel>
                <TextBlock x:Name="OverlayTitle" Style="{StaticResource OverlayText}" FontSize="20" FontWeight="SemiBold" Text="Waiting for a device" />
                <TextBlock x:Name="OverlayText" Style="{StaticResource OverlayText}" Margin="0,10,0,0"
                           Text="On the iPhone or iPad, open Control Center, tap Screen Mirroring and choose this PC." />
                <TextBlock x:Name="OverlayHint" Style="{StaticResource OverlayText}" Margin="0,10,0,0" FontSize="12" Foreground="#9A9A9A" />
            </StackPanel>
        </Border>

        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Background="{StaticResource PanelBrush}" Padding="10,4">
            <Grid>
                <TextBlock x:Name="StatusLeft" Foreground="#D0D0D0" FontSize="12" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusRight" Foreground="#9A9A9A" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
