<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AirPlay.Host</RootNamespace>
    <AssemblyName>airplay-host</AssemblyName>
    <Description>Headless AirPlay receiver host: advertises, accepts a mirroring session and dumps the H.264 stream to a file. Runs on Windows, Linux and macOS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AirPlay.Core/AirPlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../native/prebuilt/win-x64/playfair.dll')">
    <None Include="../../native/prebuilt/win-x64/playfair.dll" Link="playfair.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- On Linux/macOS build libplayfair from the vendored sources so `dotnet run` works there too. -->
  <Target Name="BuildPlayfairShared" AfterTargets="CopyFilesToOutputDirectory" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <PlayfairSrc>$(MSBuildThisFileDirectory)../../native/playfair</PlayfairSrc>
      <PlayfairOut>$(OutDir)libplayfair.so</PlayfairOut>
      <PlayfairOut Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(OutDir)libplayfair.dylib</PlayfairOut>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)" />
    <Exec Command="cc -O2 -fPIC -shared -o &quot;$(PlayfairOut)&quot; &quot;$(PlayfairSrc)/playfair.c&quot; &quot;$(PlayfairSrc)/omg_hax.c&quot; &quot;$(PlayfairSrc)/sap_hash.c&quot; &quot;$(PlayfairSrc)/modified_md5.c&quot; &quot;$(PlayfairSrc)/hand_garble.c&quot; -lm" ContinueOnError="true" />
  </Target>

</Project>
